# Cross-cutting (applies to every source folder).
# Source-specific ignores live in <source>/.gitignore (e.g. plfs/.gitignore).

# OS detritus
.DS_Store

# Python
__pycache__/
*.pyc

# Local virtualenvs
.venv/

# Local Claude harness state — not for the repo
.claude/

# GCP service-account keys — never commit credentials
avantifellows-*.json
*-service-account.json
service-account.json
*-creds.json
google_secret.json
