# state_cet-specific ignores. Paths relative to state_cet/.

# Raw consolidated CSV — landed locally before GCS upload.
# Produced upstream by the per-state scrapers + consolidate_all.py in the
# College DB repo (state-cet-scrape/). Authoritative copy lives at
# gs://avantifellows-external-data/state_cet/raw/.
raw/

# Clean parquet — the bytes BQ loads. Rebuilt by scripts/build_clean.py.
# Authoritative copy lives at gs://avantifellows-external-data/state_cet/clean/.
clean/

# Local Python env
.venv/
__pycache__/

# Upstream scraper (copied from College DB). The scraper SCRIPTS under
# scrape/scripts/ are committed (code); the raw source PDFs/HTML under
# scrape/source/ are large raw bytes — gitignored, ride in the handoff bundle
# and belong in GCS, never git.
scrape/source/
scrape/**/__pycache__/
