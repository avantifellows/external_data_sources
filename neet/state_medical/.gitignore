# state_medical-specific ignores. Paths relative to state_medical/.

# Raw national harmonized CSV — landed locally before GCS upload.
# Produced upstream by the College DB medical-state-counselling pipeline
# (35 per-state parsers + national consolidation). Authoritative copy lives at
# gs://avantifellows-external-data/state_medical/raw/.
raw/

# Clean parquet — the bytes BQ loads. Rebuilt by scripts/build_clean.py.
# Authoritative copy lives at gs://avantifellows-external-data/state_medical/clean/.
clean/

# Local Python env
.venv/
__pycache__/

# Upstream scraper (copied from College DB). The scraper SCRIPTS under
# scrape/scripts/ are committed (code); the raw source PDFs/HTML under
# scrape/source/ are large raw bytes — gitignored, ride in the handoff bundle
# and belong in GCS, never git.
scrape/source/
scrape/**/__pycache__/
